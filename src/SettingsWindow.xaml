<Window x:Class="TTJiang.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="logo.png"
        Width="604" Height="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="文件搜索（内置）"
                   FontSize="15" Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="TT酱 自带 Everything 与命令行工具，索引也建在程序目录里，不需要另外安装或指定路径。首次使用要安装一次索引服务（系统级，需要管理员授权），装好之后每次启动都不再询问。"
                   FontSize="12"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock x:Name="ServiceText"
                       Text="索引服务：检查中…"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       MinWidth="180" />
            <Button x:Name="InstallButton"
                    Content="安装索引服务…"
                    Style="{StaticResource FlatButton}"
                    Height="28" Padding="12,0" Margin="8,0,0,0"
                    TabIndex="0"
                    Click="InstallService_Click" />
            <Button x:Name="UninstallButton"
                    Content="卸载"
                    Style="{StaticResource FlatButton}"
                    Height="28" Padding="12,0" Margin="8,0,0,0"
                    TabIndex="1"
                    Click="UninstallService_Click" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <TextBlock Text="搜索结果"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="显示全部匹配，不设条数上限；滚动时按需加载"
                       FontSize="11"
                       Foreground="{StaticResource FaintBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   LineHeight="18"
                   Margin="0,12,0,0" />

        <StackPanel Grid.Row="5" VerticalAlignment="Top" Margin="0,16,0,0">
            <Border Height="1" Background="#ECECEC" Margin="0,0,0,16" />

            <TextBlock Text="快捷方式配置"
                       FontSize="15" Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,8" />

            <TextBlock Text="导出把当前的快捷方式存成一个 json 文件，换台机器导入即可恢复。导入会替换现有列表，不会动上面的搜索设置。"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal">
                <Button Content="导出…"
                        Style="{StaticResource FlatButton}"
                        Width="82" Height="30" Padding="0"
                        TabIndex="3"
                        Click="Export_Click" />
                <Button Content="导入…"
                        Style="{StaticResource FlatButton}"
                        Width="82" Height="30" Padding="0" Margin="10,0,0,0"
                        TabIndex="4"
                        Click="Import_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Style="{StaticResource FlatButton}"
                    Width="82" Height="32" Padding="0"
                    TabIndex="5"
                    Click="Cancel_Click" />
            <Button Content="保存"
                    Style="{StaticResource AccentButton}"
                    Width="82" Height="32" Padding="0" Margin="10,0,0,0"
                    TabIndex="6"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
