<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 只面向 Windows 10 / Windows 11：.NET Framework 4.8 在两套系统上均为系统内置组件，
         因此产物是一个单文件 exe，不需要安装任何运行时。 -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TT酱</AssemblyName>
    <RootNamespace>TTJiang</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>10</LangVersion>
    <NoWarn>$(NoWarn);WFAC010;CS1591</NoWarn>
    <Product>TT酱</Product>
    <AssemblyTitle>TT酱</AssemblyTitle>
    <Version>3.3.0</Version>
    <!-- 截图与 OCR 只面向 64 位：随包的 onnxruntime 与 Everything 组件都是 x64。 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.ico 只作为 ApplicationIcon 编入 Win32 RT_ICON；窗口图标复用同一份 logo.png，
         避免同一份图标数据在程序集里存两遍。 -->
    <Resource Include="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置 Everything 主程序、SDK3 DLL、命令行工具与 MIT 许可声明，
         运行时释放到 exe 同级 everything 目录 -->
    <EmbeddedResource Include="..\vendor\everything.zip" LogicalName="TTJiang.Everything.zip" />
    <!-- 离线 OCR payload：PP-OCRv6 tiny 两个模型 + onnxruntime + VC 运行库 + 字典。
         不编进 exe，随包放到 ocr 子目录（约 14 MB），首次使用直接从这里加载，
         省掉一次解压和一份重复的磁盘占用。 -->
    <None Include="..\vendor\payload\*" Link="ocr\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.ServiceProcess" />
    <!-- 截图与 OCR：GDI+ 画遮罩与工具条，WinRT 投影调用系统 OCR 回退引擎 -->
    <Reference Include="System.Drawing" />
    <!-- net48 参考程序集包不含这两个 WinRT 互操作程序集，直接用系统 Framework 自带的；
         它们是系统组件，不随程序分发。 -->
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime">
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.InteropServices.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Windows.Media.Ocr 的类型定义来自系统自带的 WinMetadata，不额外引 NuGet 包 -->
    <Reference Include="Windows.Foundation">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Foundation.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Globalization">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Globalization.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Graphics">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Graphics.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Media">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Media.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Storage">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Storage.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 只提供编译期参考程序集，不进产物 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
