<Window x:Class="TTJiang.EditShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加快捷方式"
        Icon="logo.png"
        Width="556" Height="318"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="18,16,18,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 名称 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" Margin="0,0,12,12" />
        <Border Grid.Row="0" Grid.Column="1" Width="452" Height="30"
                Background="{StaticResource InputBrush}" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <TextBox x:Name="NameBox" Style="{StaticResource PlainTextBox}" Padding="8,0" TabIndex="0" />
        </Border>

        <!-- 路径 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="路径"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" Margin="0,0,12,12" />
        <Border Grid.Row="1" Grid.Column="1" Width="452" Height="30"
                Background="{StaticResource InputBrush}" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,2,0">
                    <Button Content="文件" Style="{StaticResource FlatButton}"
                            Width="46" Height="26" Padding="0" Margin="0,0,4,0" TabIndex="6"
                            Click="BrowseFile_Click" />
                    <Button Content="目录" Style="{StaticResource FlatButton}"
                            Width="46" Height="26" Padding="0" TabIndex="7"
                            Click="BrowseFolder_Click" />
                </StackPanel>
                <TextBox x:Name="PathBox" Style="{StaticResource PlainTextBox}" Padding="8,0" TabIndex="1" />
            </DockPanel>
        </Border>

        <!-- 参数 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="参数"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" Margin="0,0,12,12" />
        <Border Grid.Row="2" Grid.Column="1" Width="452" Height="30"
                Background="{StaticResource InputBrush}" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <TextBox x:Name="ArgsBox" Style="{StaticResource PlainTextBox}" Padding="8,0" TabIndex="2" />
        </Border>

        <!-- 分类 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="分类"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" Margin="0,0,12,12" />
        <Border Grid.Row="3" Grid.Column="1" Width="452" Height="30"
                Background="{StaticResource InputBrush}" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="CategoryPickButton" DockPanel.Dock="Right"
                        Content="▾" Style="{StaticResource FlatButton}"
                        Width="30" Height="26" Padding="0" Margin="0,0,2,0"
                        Click="CategoryPick_Click" />
                <TextBox x:Name="CategoryBox" Style="{StaticResource PlainTextBox}" Padding="8,0" TabIndex="3" />
            </DockPanel>
        </Border>

        <!-- 提示 -->
        <TextBlock Grid.Row="4" Grid.Column="1" Width="452"
                   Text="路径可填：程序或文件的完整路径、calc.exe 这类命令、shell:Downloads、或文件夹"
                   FontSize="11" Foreground="{StaticResource FaintBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,6" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource FlatButton}"
                    Width="82" Height="32" Padding="0" TabIndex="4" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource AccentButton}"
                    Width="82" Height="32" Padding="0" Margin="10,0,0,0" TabIndex="5" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
